{
  // Read Aloud Studio — website + AI helper in one Worker.
  "name": "read-aloud-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "ASK_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Comma-separated extra sites allowed to call /api/ask (the Worker's own address is always allowed).
    "EXTRA_ORIGINS": "https://bnbke.github.io"
  },
  "observability": { "enabled": true }
}
